# ============================================
# AI Job Agent - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Application ---
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=generate-with-openssl-rand-hex-32
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
POSTGRES_USER=jobagent
POSTGRES_PASSWORD=generate_a_secure_postgres_password
POSTGRES_DB=jobagent
DATABASE_URL=postgresql+asyncpg://jobagent:generate_a_secure_postgres_password@postgres:5432/jobagent

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Postgres Admin (pgAdmin 4) ---
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=generate_a_secure_pgadmin_password

# --- Safety Controls ---
DRY_RUN=true
HUMAN_APPROVAL_REQUIRED=true
AUTO_SUBMIT_ENABLED=false
DAILY_APPLICATION_LIMIT=10
MINIMUM_JOB_SCORE=60

# --- AI Providers ---
# Gemini (high-quality reasoning: resume tailoring, cover letters, validation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_ENABLED=false

# Groq (fast/free operations: extraction, classification, initial scoring)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_ENABLED=false

# Local LLM (Ollama or compatible, fallback when cloud is unavailable)
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_ENABLED=false

# --- CORS & Networking ---
# For local development: ["http://localhost:3000","https://localhost:3000"]
# For Oracle Cloud HTTPS: ["https://agent.jobs.shubhamprakash681.in:3000","https://agent.jobs.shubhamprakash681.in","https://agent.jobs.shubhamprakash681.in:4000"]
CORS_ORIGINS=["http://localhost:3000","https://localhost:3000","https://agent.jobs.shubhamprakash681.in:3000","https://agent.jobs.shubhamprakash681.in","https://agent.jobs.shubhamprakash681.in:4000"]
BACKEND_API_URL=http://backend:4000
NEXT_PUBLIC_API_URL=https://agent.jobs.shubhamprakash681.in:4000

# --- Cloud Deployment & Port Bindings (Oracle Cloud VM.Standard.A1.Flex) ---
FRONTEND_PORT_BINDING=127.0.0.1:3001
BACKEND_PORT_BINDING=127.0.0.1:4001

# Secure internal service bindings (defaults to 127.0.0.1 to avoid exposing DB/Redis to the internet)
POSTGRES_PORT_BINDING=127.0.0.1:5431
REDIS_PORT_BINDING=127.0.0.1:6379
PGADMIN_PORT_BINDING=127.0.0.1:5050
