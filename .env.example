# ============================================
# AI Job Agent - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Application ---
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
LOG_LEVEL=INFO

# --- Database ---
# For Docker: postgresql+asyncpg://jobagent:jobagent_dev@postgres:5432/jobagent
# For local dev: postgresql+asyncpg://jobagent:jobagent_dev@localhost:5431/jobagent
# For SQLite (dev only): sqlite+aiosqlite:///./jobagent.db
DATABASE_URL=postgresql+asyncpg://jobagent:jobagent_dev@localhost:5431/jobagent

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Safety ---
DRY_RUN=true
HUMAN_APPROVAL_REQUIRED=true
AUTO_SUBMIT_ENABLED=false
DAILY_APPLICATION_LIMIT=10
MINIMUM_JOB_SCORE=60

# --- AI Providers ---
# Gemini (for high-quality reasoning: resume tailoring, cover letters, validation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_ENABLED=false

# Groq (for fast/free operations: extraction, classification, initial scoring)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_ENABLED=false

# Local LLM (Ollama or compatible, fallback when cloud is unavailable)
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_ENABLED=false

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Email (Phase 9+) ---
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=

# --- Notifications (Optional) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=
